# Конфигурация Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Модели (используем легкие модели из-за ограничения дискового пространства)
MAIN_MODEL=qwen2.5:0.5b
FAST_MODEL=qwen2.5:0.5b

# Директория для моделей Ollama (временное решение из-за нехватки места в root)
OLLAMA_MODELS=/tmp/ollama_models
